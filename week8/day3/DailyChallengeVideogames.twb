    <worksheet name='Percentage of sales by region and game'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#29303b' fontname='gotham-rounded' fontsize='14'>Percentage of sales by &lt;</run>
            <run fontcolor='#29303b' fontname='gotham-rounded' fontsize='14'>[Parameters].[Parameter 1]</run>
            <run fontcolor='#29303b' fontname='gotham-rounded' fontsize='14'>&gt; and game</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vgsales' name='federated.1xfm4c81ylk0h011z1uc40f9scuy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='North America' caption='Region' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;NA&quot;'>
              <calculation class='tableau' formula='&quot;NA&quot;' />
              <aliases>
                <alias key='&quot;EU&quot;' value='Europe' />
                <alias key='&quot;JP&quot;' value='Japan' />
                <alias key='&quot;NA&quot;' value='North America' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xfm4c81ylk0h011z1uc40f9scuy'>
            <column caption='RegionSpecificSales' datatype='real' name='[Calculation_1928948079331274757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]==&apos;NA&apos; THEN sum([NA_Sales])&#13;&#10;    ELSEIF [Parameters].[Parameter 1]==&apos;EU&apos; THEN sum([EU_Sales])&#13;&#10;    ELSEIF [Parameters].[Parameter 1]==&apos;Other&apos; THEN sum([Other_Sales])&#13;&#10;    ELSEIF [Parameters].[Parameter 1]==&apos;JP&apos; THEN sum([JP_Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 1]==&apos;ALL&apos; THEN sum([Global_Sales]) END' />
            </column>
            <column caption='RegionSpecificSalesPerc' datatype='real' name='[Calculation_1928948079333433350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]==&apos;NA&apos; THEN sum([NA_Sales])/sum({FIXED: sum([Global_Sales])})&#13;&#10;    ELSEIF [Parameters].[Parameter 1]==&apos;EU&apos; THEN sum([EU_Sales])/sum({FIXED: sum([Global_Sales])})&#13;&#10;    ELSEIF [Parameters].[Parameter 1]==&apos;Other&apos; THEN sum([Other_Sales])/sum({FIXED: sum([Global_Sales])})&#13;&#10;    ELSEIF [Parameters].[Parameter 1]==&apos;JP&apos; THEN sum([JP_Sales])/sum({FIXED: sum([Global_Sales])})&#13;&#10;ELSEIF [Parameters].[Parameter 1]==&apos;ALL&apos; THEN sum([Global_Sales])/sum({FIXED: sum([Global_Sales])}) END' />
            </column>
            <column caption='EU Sales' datatype='real' name='[EU_Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Genre]' role='dimension' type='nominal' />
            <column caption='Global Sales' datatype='real' name='[Global_Sales]' role='measure' type='quantitative' />
            <column caption='JP Sales' datatype='real' name='[JP_Sales]' role='measure' type='quantitative' />
            <column caption='NA Sales' datatype='real' name='[NA_Sales]' role='measure' type='quantitative' />
            <column caption='Other Sales' datatype='real' name='[Other_Sales]' role='measure' type='quantitative' />
            <column-instance column='[Genre]' derivation='None' name='[none:Genre:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1928948079331274757]' derivation='User' name='[usr:Calculation_1928948079331274757:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1928948079333433350]' derivation='User' name='[usr:Calculation_1928948079333433350:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
