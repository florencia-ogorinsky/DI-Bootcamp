      <aliases enabled='yes' />
      <column caption='DifferenceBetweenGlogalAndRegionalSum' datatype='real' name='[Calculation_890305414574227456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Global_Sales])-sum([EU_Sales])-sum([JP_Sales])-sum([NA_Sales])-sum([Other_Sales])' />
      </column>
      <column caption='Profitability Index' datatype='real' name='[Calculation_890305414580568065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Global_Sales]-0.3*[Global_Sales]))/sum({FIXED: sum([Global_Sales])})&#13;&#10;//(sum([Global Sales])-0.3*sum([Global Sales])) this is the profit revenue&#13;&#10;//sum([Global Sales]) this denominator must be the total sales over all genres' />
      </column>
      <column caption='Sales Performance Index' datatype='integer' name='[Calculation_890305414694449154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Global_Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='index' datatype='integer' name='[Calculation_890305414700662787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fixed Global Sales' datatype='real' name='[Calculation_890305414706634758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Name]: SUM([Global_Sales]) }' />
      </column>
      <column caption='YoY Growth Rate' datatype='real' name='[Calculation_890305414709960711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Global_Sales]) - LOOKUP(SUM([Global_Sales]), -1)) / LOOKUP(SUM([Global_Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Genre Dominance Ratio' datatype='real' name='[Calculation_890305414710468616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales]) / TOTAL(SUM([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='None' caption='EU Sales (bin)' datatype='integer' name='[EU Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[EU_Sales]' peg='0' size='5' />
      </column>
      <column caption='EU Sales' datatype='real' name='[EU_Sales]' role='measure' type='quantitative' />
      <column datatype='string' name='[Genre]' role='dimension' type='nominal' />
